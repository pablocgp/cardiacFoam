/* Modified for cardiacFoam (parallel port):
     - PETSc: was hardcoded to the system petsc3.15, but libsolids4FoamModels
       links PETSc 3.23 from $(PETSC_DIR)/$(PETSC_ARCH). Linking both into one
       process is an ABI hazard, so we follow the library and use $(PETSC_DIR).
       Note the library is plain -lpetsc there, not -lpetsc_real.
     - Eigen: was taken from the solids4foam-ib tree; use the -ib-pc tree that
       this solver is actually built against.
     - solids4FoamModels lnInclude: path simplified, $(SOLIDS4FOAM_DIR) already
       points at solids4foam-ib-pc.
   The OpenMPI paths are unchanged: PETSc and OpenFOAM are both built against
   the same system libmpi.so.40.

     - pull in solids4foam's wmake-options, which is what actually defines
       VERSION_SPECIFIC_INC (-DOPENFOAM_COM -DOPENFOAM_NOT_EXTEND). It was
       already referenced below but never defined, so it expanded to nothing.
       LRE.H did not care; symmTensor3rdOrder.H does, and without the define it
       takes the foam-extend branch and fails to compile.
     - added the highOrderAdapter include path (highOrderInterp.H). */

sinclude $(SOLIDS4FOAM_DIR)/etc/wmake-options

EXE_INC = \
    -I../../../src/highOrderAdapter \
    -I$(LIB_SRC)/ODE/lnInclude \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(SOLIDS4FOAM_DIR)/src/solids4FoamModels/lnInclude \
    $(VERSION_SPECIFIC_INC) \
    -I$(PETSC_DIR)/include \
    -I$(PETSC_DIR)/$(PETSC_ARCH)/include \
    -I/usr/lib/x86_64-linux-gnu/openmpi/include \
    -I/usr/lib/x86_64-linux-gnu/openmpi/include/openmpi \
    -I$(SOLIDS4FOAM_DIR)/ThirdParty/eigen3 \
    -fopenmp \
    -Wno-old-style-cast -Wno-deprecated-declarations -Wno-unused-parameter \

EXE_LIBS = \
    -L$(FOAM_USER_LIBBIN) \
    -lfiniteVolume \
    -lfvOptions \
    -lmeshTools \
    -lODE \
    -lsolids4FoamModels \
    -L$(PETSC_DIR)/$(PETSC_ARCH)/lib \
    -lpetsc \
    -L/usr/lib/x86_64-linux-gnu/openmpi/lib \
    -lmpi_cxx \
    -lmpi \
    -lfftw3_mpi \
    -lfftw3 \
    -fopenmp
