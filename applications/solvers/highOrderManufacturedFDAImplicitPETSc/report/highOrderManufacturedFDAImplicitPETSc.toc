\contentsline {subsection}{\numberline {11.3}Discussion of the 2D results}{40}{subsection.11.3}%
\contentsline {paragraph}{The three nonlinear methods are numerically indistinguishable.}{40}{section*.12}%
\contentsline {paragraph}{In this regime Picard is the cheapest, despite needing more iterations.}{40}{section*.13}%
\contentsline {paragraph}{Only odd reconstruction degrees buy a new order.}{41}{section*.14}%
\contentsline {paragraph}{The standard operator loses consistency on the unstructured mesh.}{41}{section*.15}%
\contentsline {paragraph}{The bottleneck moves to the ionic path once $V_{\text {m}}$ is high order.}{41}{section*.16}%
\contentsline {paragraph}{\texttt {\small cellCentredReconstruct} dominates \texttt {\small gaussPointODE}.}{42}{section*.17}%
\contentsline {paragraph}{With $\Delta t=10^{-2}$ the temporal floor contaminates the state rates.}{42}{section*.18}%
\contentsline {paragraph}{Stabilisation is unnecessary in 2D.}{42}{section*.19}%
