\contentsline {subsection}{\numberline {11.5}Discussion of the 3D results}{59}{subsection.11.5}%
\contentsline {paragraph}{The qualitative structure repeats, but the 3D sweep is pre-asymptotic.}{59}{section*.26}%
\contentsline {paragraph}{The temporal error does not intervene in 3D.}{60}{section*.27}%
\contentsline {paragraph}{Stabilisation does matter in 3D, and its sign is case dependent.}{60}{section*.28}%
\contentsline {paragraph}{The unstructured tetrahedral mesh beats the hexahedral one at high order.}{60}{section*.29}%
\contentsline {paragraph}{High order in 3D is limited by memory, not by the solver.}{60}{section*.30}%
\contentsline {paragraph}{Configuration recommendation.}{60}{section*.31}%
