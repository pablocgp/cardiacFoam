\@writefile{toc}{\contentsline {subsection}{\numberline {11.3}Discussion of the 2D results}{40}{subsection.11.3}\protected@file@percent }
\newlabel{sec:en-conclusions-2d}{{11.3}{40}{Discussion of the 2D results}{subsection.11.3}{}}
\@writefile{toc}{\contentsline {paragraph}{The three nonlinear methods are numerically indistinguishable.}{40}{section*.12}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{In this regime Picard is the cheapest, despite needing more iterations.}{40}{section*.13}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Only odd reconstruction degrees buy a new order.}{41}{section*.14}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The standard operator loses consistency on the unstructured mesh.}{41}{section*.15}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The bottleneck moves to the ionic path once $V_{\text  {m}}$ is high order.}{41}{section*.16}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{\texttt  {\small  cellCentredReconstruct} dominates \texttt  {\small  gaussPointODE}.}{42}{section*.17}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{With $\Delta t=10^{-2}$ the temporal floor contaminates the state rates.}{42}{section*.18}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Stabilisation is unnecessary in 2D.}{42}{section*.19}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {11.4}Three-dimensional manufactured problem}{42}{subsection.11.4}\protected@file@percent }
\newlabel{sec:en-results-3d}{{11.4}{42}{Three-dimensional manufactured problem}{subsection.11.4}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {11.4.1}\texttt  {\small  Picard}}{42}{subsubsection.11.4.1}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{$\Delta t=10^{-2}$}{42}{section*.20}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces 3D manufactured results for \texttt  {\small  Picard}, \texttt  {\small  crankNicolson}, \texttt  {\small  consistent} mass, \texttt  {\small  RKF45} states, and $\Delta t=10^{-2}$. The first convergence block is fitted over $N=10$--$30$; the second over $N=20$--$30$. The first column records the actual \texttt  {\small  Vm-states-Iion} triplet used by the run. \textbf  {RB} is the number of time steps that exhausted the nonlinear iteration budget, accumulated over the 21 mesh sizes of the row (105 time steps per row in total). \texttt  {\small  Picard} accepts its last iterate with a warning instead of rolling back, so for this method the column counts steps accepted without converging. \textbf  {$n_{\mathrm  {nl}}$} reports the median and the maximum number of nonlinear iterations per step over those same steps; the configured budget is \texttt  {\small  nonlinearIterations}$=2000$.\relax }}{43}{table.9}\protected@file@percent }
