\@writefile{toc}{\contentsline {subsection}{\numberline {11.5}Discussion of the 3D results}{59}{subsection.11.5}\protected@file@percent }
\newlabel{sec:en-conclusions-3d}{{11.5}{59}{Discussion of the 3D results}{subsection.11.5}{}}
\@writefile{toc}{\contentsline {paragraph}{The qualitative structure repeats, but the 3D sweep is pre-asymptotic.}{59}{section*.26}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The temporal error does not intervene in 3D.}{60}{section*.27}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Stabilisation does matter in 3D, and its sign is case dependent.}{60}{section*.28}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The unstructured tetrahedral mesh beats the hexahedral one at high order.}{60}{section*.29}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{High order in 3D is limited by memory, not by the solver.}{60}{section*.30}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Configuration recommendation.}{60}{section*.31}\protected@file@percent }
\gdef \@abspage@last{60}
