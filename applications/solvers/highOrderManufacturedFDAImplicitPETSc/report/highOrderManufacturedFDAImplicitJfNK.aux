\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces 3D manufactured results for \texttt  {\small  Picard} with $\Delta t=10^{-3}$. The first six convergence columns are log--log fits over meshes $N=10$--$30$; the next six columns are fits over $N=20$--$30$. The time column is the sum of the reported wall-clock total over all mesh runs in the row, and the memory column is the sum of the reported peak resident memory in MB over the same mesh runs. The corresponding convergence figures are Figs.\nobreakspace  {}\ref  {fig:results-3d-picard-1p0em03-backwardeuler-consistent}, \ref  {fig:results-3d-picard-1p0em03-backwardeuler-lumped}, \ref  {fig:results-3d-picard-1p0em03-cranknicolson-consistent}, \ref  {fig:results-3d-picard-1p0em03-cranknicolson-lumped}.\relax }}{50}{table.9}\protected@file@percent }
