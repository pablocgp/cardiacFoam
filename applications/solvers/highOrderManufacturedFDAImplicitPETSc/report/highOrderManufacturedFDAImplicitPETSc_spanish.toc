\contentsline {subsection}{\numberline {11.3}Discusión de los resultados 2D}{41}{subsection.11.3}%
\contentsline {paragraph}{Los tres métodos no lineales son numéricamente indistinguibles.}{41}{section*.12}%
\contentsline {paragraph}{En este régimen Picard es el más barato, pese a necesitar más iteraciones.}{42}{section*.13}%
\contentsline {paragraph}{Sólo los grados impares de reconstrucción compran un orden nuevo.}{42}{section*.14}%
\contentsline {paragraph}{El operador estándar pierde consistencia en la malla no estructurada.}{42}{section*.15}%
\contentsline {paragraph}{El cuello de botella se desplaza al camino iónico cuando $V_{\text {m}}$ es de alto orden.}{42}{section*.16}%
\contentsline {paragraph}{\texttt {\small cellCentredReconstruct} domina a \texttt {\small gaussPointODE}.}{43}{section*.17}%
\contentsline {paragraph}{Con $\Delta t=10^{-2}$ el piso temporal contamina las tasas de los estados.}{43}{section*.18}%
\contentsline {paragraph}{La estabilización es innecesaria en 2D.}{43}{section*.19}%
