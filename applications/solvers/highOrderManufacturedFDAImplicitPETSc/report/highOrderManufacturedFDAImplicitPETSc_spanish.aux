\@writefile{toc}{\contentsline {subsection}{\numberline {11.5}Discusión de los resultados 3D}{60}{subsection.11.5}\protected@file@percent }
\newlabel{sec:es-conclusiones-3d}{{11.5}{60}{Discusión de los resultados 3D}{subsection.11.5}{}}
\@writefile{toc}{\contentsline {paragraph}{La estructura cualitativa se repite, pero el barrido 3D es pre-asintótico.}{60}{section*.26}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{El error temporal no interviene en 3D.}{61}{section*.27}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{La estabilización sí importa en 3D, y su signo depende del caso.}{61}{section*.28}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{La malla tetraédrica no estructurada supera a la hexaédrica en alto orden.}{61}{section*.29}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{El alto orden en 3D está limitado por la memoria, no por el solver.}{61}{section*.30}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Recomendación de configuración.}{61}{section*.31}\protected@file@percent }
\gdef \@abspage@last{61}
