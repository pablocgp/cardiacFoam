\@writefile{toc}{\contentsline {subsection}{\numberline {11.3}Discusión de los resultados 2D}{41}{subsection.11.3}\protected@file@percent }
\newlabel{sec:es-conclusiones-2d}{{11.3}{41}{Discusión de los resultados 2D}{subsection.11.3}{}}
\@writefile{toc}{\contentsline {paragraph}{Los tres métodos no lineales son numéricamente indistinguibles.}{41}{section*.12}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{En este régimen Picard es el más barato, pese a necesitar más iteraciones.}{42}{section*.13}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Sólo los grados impares de reconstrucción compran un orden nuevo.}{42}{section*.14}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{El operador estándar pierde consistencia en la malla no estructurada.}{42}{section*.15}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{El cuello de botella se desplaza al camino iónico cuando $V_{\text  {m}}$ es de alto orden.}{42}{section*.16}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{\texttt  {\small  cellCentredReconstruct} domina a \texttt  {\small  gaussPointODE}.}{43}{section*.17}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Con $\Delta t=10^{-2}$ el piso temporal contamina las tasas de los estados.}{43}{section*.18}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{La estabilización es innecesaria en 2D.}{43}{section*.19}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {11.4}Problema manufacturado tridimensional}{43}{subsection.11.4}\protected@file@percent }
\newlabel{sec:es-results-3d}{{11.4}{43}{Problema manufacturado tridimensional}{subsection.11.4}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {11.4.1}\texttt  {\small  Picard}}{43}{subsubsection.11.4.1}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{$\Delta t=10^{-2}$}{43}{section*.20}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Resultados manufacturados 3D para \texttt  {\small  Picard}, \texttt  {\small  crankNicolson}, masa \texttt  {\small  consistent}, estados \texttt  {\small  RKF45} y $\Delta t=10^{-2}$. El primer bloque de convergencia se ajusta sobre $N=10$--$30$; el segundo sobre $N=20$--$30$. La primera columna registra la terna \texttt  {\small  Vm-states-Iion} efectivamente usada en la corrida. \textbf  {RB} es la cantidad de pasos de tiempo que agotaron el presupuesto de iteraciones no lineales, acumulada sobre los 21 tamaños de malla de la fila (105 pasos de tiempo en total por fila). \texttt  {\small  Picard} acepta el último iterado con advertencia en vez de hacer rollback, de modo que para este método la columna cuenta pasos aceptados sin converger. \textbf  {$n_{\mathrm  {nl}}$} reporta la mediana y el máximo de iteraciones no lineales por paso sobre esos mismos pasos; el presupuesto configurado es \texttt  {\small  nonlinearIterations}$=2000$.\relax }}{44}{table.9}\protected@file@percent }
\newlabel{tab:es-results-3d-picard-1p0em02}{{9}{44}{Resultados manufacturados 3D para \code {Picard}, \code {crankNicolson}, masa \code {consistent}, estados \code {RKF45} y $\Delta t=10^{-2}$. El primer bloque de convergencia se ajusta sobre $N=10$--$30$; el segundo sobre $N=20$--$30$. La primera columna registra la terna \code {Vm-states-Iion} efectivamente usada en la corrida. \textbf {RB} es la cantidad de pasos de tiempo que agotaron el presupuesto de iteraciones no lineales, acumulada sobre los 21 tamaños de malla de la fila (105 pasos de tiempo en total por fila). \code {Picard} acepta el último iterado con advertencia en vez de hacer rollback, de modo que para este método la columna cuenta pasos aceptados sin converger. \textbf {$n_{\mathrm {nl}}$} reporta la mediana y el máximo de iteraciones no lineales por paso sobre esos mismos pasos; el presupuesto configurado es \code {nonlinearIterations}$=2000$.\relax }{table.9}{}}
