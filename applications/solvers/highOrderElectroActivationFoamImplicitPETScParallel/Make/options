/* Modified for cardiacFoam (LRE -> movingLeastSquares port):

     - sinclude solids4foam's wmake-options. $(VERSION_SPECIFIC_INC) was already
       referenced below but never defined, so it expanded to nothing. LRE.H did
       not care; symmTensor3rdOrder.H, pulled in by highOrderInterp.H, does:
       without -DOPENFOAM_COM it takes the foam-extend branch and fails to
       compile.
     - added the highOrderAdapter include path (highOrderInterp.H).
     - PETSc: was hardcoded to the system petsc3.15, but libsolids4FoamModels
       links PETSc 3.23 from $(PETSC_DIR)/$(PETSC_ARCH). Two PETSc versions in
       one process is an ABI hazard, and this solver has to load that library.
       Note the library there is plain -lpetsc, not -lpetsc_real.
     - Eigen taken from the solids4foam-ib-pc tree actually being built against,
       not the -ib one.
     - solids4FoamModels lnInclude path simplified: $(SOLIDS4FOAM_DIR) already
       points at solids4foam-ib-pc, so the round trip through .. was redundant.

   The OpenMPI paths are unchanged: PETSc 3.23 and OpenFOAM's sys-openmpi are
   both built against the same system libmpi.so.40. */

sinclude $(SOLIDS4FOAM_DIR)/etc/wmake-options

EXE_INC = \
    -I../../../src/highOrderAdapter \
    -I../../../src/ionicModels/lnInclude \
    -I../../../src/genericWriter/lnInclude \
    -I../../../src/couplingModels \
    -I$(LIB_SRC)/ODE/lnInclude \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(SOLIDS4FOAM_DIR)/src/solids4FoamModels/lnInclude \
    $(VERSION_SPECIFIC_INC) \
    -I$(PETSC_DIR)/include \
    -I$(PETSC_DIR)/$(PETSC_ARCH)/include \
    -I/usr/lib/x86_64-linux-gnu/openmpi/include \
    -I/usr/lib/x86_64-linux-gnu/openmpi/include/openmpi \
    -I$(SOLIDS4FOAM_DIR)/ThirdParty/eigen3 \
    -fopenmp \
    -Wno-old-style-cast -Wno-deprecated-declarations -Wno-unused-parameter \

EXE_LIBS = \
    -L$(FOAM_USER_LIBBIN) \
    -lionicModels \
    -lfiniteVolume \
    -lfvOptions \
    -lmeshTools \
    -lODE \
    -lsolids4FoamModels \
    -L$(PETSC_DIR)/$(PETSC_ARCH)/lib \
    -lpetsc \
    -L/usr/lib/x86_64-linux-gnu/openmpi/lib \
    -lmpi_cxx \
    -lmpi \
    -lfftw3_mpi \
    -lfftw3 \
    -fopenmp
